# EKLK - Environment Configuration
# Copy to .env and fill values

APP_NAME=EKLK
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Security
SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Database
DATABASE_URL=sqlite:////tmp/eklk.db

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=detailed