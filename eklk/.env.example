# EKLK Backend
APP_NAME=EKLK
APP_VERSION=1.0.0
# Production: DEBUG=false, LOG_LEVEL=INFO
DEBUG=false
# REQUIRED in production: long random string (>= 32 chars). Do not use the default.
SECRET_KEY=change-me-to-long-random-secret-key-at-least-32-chars!!
ACCESS_TOKEN_EXPIRE_MINUTES=480

# EcomKassa (can also be set per-user in UI)
ECOMKASSA_BASE_URL=https://app.ecomkassa.ru
ECOMKASSA_LOGIN=sales@ecomkassa.ru
ECOMKASSA_PASSWORD=ecomkassa1
ECOMKASSA_GROUP_CODE=990
ECOMKASSA_API_VERSION=v5

# Database
DATABASE_URL=sqlite+aiosqlite:///./eklk.db

# Logging
LOG_LEVEL=INFO

# Shared HTTP client to EcomKassa (per worker process)
# HTTP_MAX_CONNECTIONS=100
# HTTP_MAX_KEEPALIVE_CONNECTIONS=20
# HTTP_TIMEOUT_SECONDS=30

# Session store (production multi-worker: redis)
# SESSION_BACKEND=memory|redis
SESSION_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379/0
# Password/ecom_token in Redis are Fernet-encrypted using SECRET_KEY
# Changing SECRET_KEY invalidates all sessions (users must re-login)


# ИИ-кассир (iikassa.ru partner-embed)
# IIKASSA_PARTNER_ID=eklk
# IIKASSA_PARTNER_SECRET=   # для action=issue; выдаёт владелец проекта ИИ-кассира
# IIKASSA_EMBED_URL=https://functions.poehali.dev/10219b97-9c66-4c02-b8a3-939f2d6e06c6

# Catalog service (CRUD / import) — HTTP Basic
# Одна сервисная учётка EcomKassa для catalog.ecomkassa.ru
# ИНН клиента в path/body берётся только из профиля организации пользователя (не из запроса)
CATALOG_BASE_URL=https://catalog.ecomkassa.ru
CATALOG_BASIC_USER=
CATALOG_BASIC_PASSWORD=
